<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal accessibility service: it only draws the corner overlays.
    No window-content access, no gestures, and it listens only for announcements (and ignores them).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:notificationTimeout="1000"
    android:settingsActivity="dev.thorcorners.MainActivity" />
